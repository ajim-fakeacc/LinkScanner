// --- 🧠 SCANNING LOGIC ---
Future<void> scanAndShowResult(BuildContext context, String url, {String source = 'Manual', bool forceRescan = false}) async {
  if (url.isEmpty) return;

  showDialog(
    context: context,
    barrierDismissible: false,
    builder: (context) => const Center(
      child: Card(
        child: Padding(
          padding: EdgeInsets.all(20),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              CircularProgressIndicator(),
              SizedBox(height: 15),
              Text("Analyzing Link..."),
            ],
          ),
        ),
      ),
    ),
  );

  bool isSafe = true;
  String message = "";
  String tip = ""; 
  
  Map<String, dynamic>? existingScan;
  if (!forceRescan) {
    existingScan = await DatabaseHelper.instance.getScanResult(url);
  }

  if (existingScan != null) {
    if (context.mounted) Navigator.pop(context); 
    isSafe = existingScan['isSafe'] == 1;
    message = isSafe ? "Safe (From History)" : "Dangerous (From History)";
    tip = "Refresh to check this link again with the latest AI data.";
  } else {
    try {
      final response = await http.post(
        // 👇 YOUR SERVER URL
        Uri.parse('https://5000-firebase-linkscanner-1766972266960.cluster-ubrd2huk7jh6otbgyei4h62ope.cloudworkstations.dev/predict'), 
        headers: {"Content-Type": "application/json"},
        body: jsonEncode({"url": url}),
      ).timeout(const Duration(seconds: 10));

      if (context.mounted) Navigator.pop(context);

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        isSafe = data['is_safe'];
        tip = data['tips'] ?? "Always be cautious.";
        message = isSafe ? "Safe (Fresh Scan)" : "Dangerous! (Fresh Scan)";
        await DatabaseHelper.instance.insertScan(url, isSafe, source);
      } else {
        isSafe = false;
        message = "Server Error: ${response.statusCode}";
        tip = "Check server connection.";
      }
    } catch (e) {
      if (context.mounted) Navigator.pop(context);
      isSafe = !(url.contains("virus") || url.contains("phish"));
      message = "Could not reach server. Basic check applied.";
      tip = "Server offline. Be careful.";
    }
  }

  if (context.mounted) {
    await showDialog(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: isSafe ? Colors.green.shade50 : Colors.red.shade50,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(15)),
        title: Row(
          children: [
            Icon(isSafe ? Icons.check_circle : Icons.warning, 
                color: isSafe ? Colors.green : Colors.red, size: 30),
            const SizedBox(width: 10),
            Text(isSafe ? "Safe Link" : "Dangerous!", 
                style: TextStyle(color: isSafe ? Colors.green.shade800 : Colors.red.shade800)),
          ],
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text("URL:", style: TextStyle(fontWeight: FontWeight.bold)),
            Text(url, style: const TextStyle(color: Colors.blueGrey, fontSize: 13)),
            const Divider(),
            Container(
              padding: const EdgeInsets.all(10),
              decoration: BoxDecoration(
                // ✅ FIXED: Using .withValues(alpha: ...)
                color: isSafe 
                    ? Colors.green.withValues(alpha: 0.1) 
                    : Colors.red.withValues(alpha: 0.1),
                borderRadius: BorderRadius.circular(8),
                border: Border.all(color: isSafe ? Colors.green : Colors.red, width: 0.5),
              ),
              child: Row(
                children: [
                  Icon(Icons.lightbulb, size: 20, color: isSafe ? Colors.green[700] : Colors.red[700]),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Text(
                      tip, 
                      style: TextStyle(
                        fontStyle: FontStyle.italic,
                        color: isSafe ? Colors.green[900] : Colors.red[900],
                        fontSize: 12
                      ),
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 10),
            Text(message, style: const TextStyle(fontSize: 14)),
          ],
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context), child: const Text("Close")),
          if (isSafe)
            FilledButton.icon(
              onPressed: () {
                Navigator.pop(context);
                launchUrl(Uri.parse(url), mode: LaunchMode.externalApplication);
              },
              icon: const Icon(Icons.open_in_browser),
              label: const Text("Open"),
            )
        ],
      ),
    );
  }
}

